  describe("MTFX-I2: Goods conservation in local clearing", () => {
    const assertMtfxI2GoodsTransfer = (
      sellerBefore: number,
      buyerBefore: number,
      sellerAfter: number,
      buyerAfter: number,
      tradeQuantity: number,
    ): void => {
      const sellerDecrease = sellerBefore - sellerAfter;
      const buyerIncrease = buyerAfter - buyerBefore;

      expect(Math.abs(sellerDecrease - buyerIncrease)).toBeLessThan(quantityEpsilon);
      expect(Math.abs(sellerDecrease - tradeQuantity)).toBeLessThan(quantityEpsilon);
      expect(Math.abs(buyerIncrease - tradeQuantity)).toBeLessThan(quantityEpsilon);
      expect(sellerAfter).toBeGreaterThanOrEqual(0);
      expect(buyerAfter).toBeGreaterThanOrEqual(0);
      expect(Math.abs((sellerBefore + buyerBefore) - (sellerAfter + buyerAfter))).toBeLessThan(quantityEpsilon);
    };

    it("executes the canonical actor-owned settlement boundary and proves seller decrease equals buyer increase", () => {
      // Build the real canonical opening world so the proof observes the same actor-owned
      // stock MarketSettlement.executeAllocation() mutates in production. The seller is a
      // ProductionUnit OUTPUT inventory; the buyer is a Cohort householdInventory.
      const world = buildInitialWorld(
        baselineScenario,
        baselineDefinitionPack,
        createDefaultSimulationConfig(),
        42,
      );
      const counterparties = canonicalDispatchCounterparties(world);
      const region = world.regions.get(counterparties.regionId)!;
      const sellerUnit = world.productionUnits.get(counterparties.sellerUnitId)!;
      const buyerCohort = world.cohorts.get(counterparties.buyerCohortId)!;
      const sellerInventoryBefore = sellerUnit.outputInventory.get(counterparties.goodId) ?? 0;
      const buyerInventoryBefore = buyerCohort.householdInventory.get(counterparties.goodId) ?? 0;
      const buyerCash = buyerCohort.wallet.get(region.settlementCurrencyId) ?? 0;
      const marketPrice = 1.0;
      const desiredQuantity = Math.min(1, sellerInventoryBefore, buyerCash / marketPrice);

      expect(desiredQuantity).toBeGreaterThan(0);

      const sellerIntent: MarketIntent = {
        id: createMarketIntentId("mi:production-unit-seller-i2"),
        actor: { type: "PRODUCTION_UNIT", productionUnitId: counterparties.sellerUnitId },
        regionId: counterparties.regionId,
        goodId: counterparties.goodId,
        side: "SELL",
        purpose: "INVENTORY_REBALANCE",
        desiredQuantity,
        sourcePlanId: "plan-seller-i2",
        inventoryBucket: "OUTPUT",
      };
      const buyerIntent: MarketIntent = {
        id: createMarketIntentId("mi:cohort-buyer-i2"),
        actor: { type: "COHORT", cohortId: counterparties.buyerCohortId },
        regionId: counterparties.regionId,
        goodId: counterparties.goodId,
        side: "BUY",
        purpose: "CONSUMPTION",
        desiredQuantity,
        maxSpend: buyerCash,
        sourcePlanId: "plan-buyer-i2",
        inventoryBucket: "GENERAL",
      };
      const input: LocalClearingInput = {
        marketId: createTestMarketId("market-i2-production-path"),
        regionId: counterparties.regionId,
        goodId: counterparties.goodId,
        pass: "MAIN",
        marketCurrencyId: region.settlementCurrencyId,
        buyerIntents: [buyerIntent],
        sellerIntents: [sellerIntent],
        computeEffectiveDemand: () => desiredQuantity,
        computeSellableQuantity: () => desiredQuantity,
        computeGrossUnitPrice: (_intent, sellerNetPrice) => sellerNetPrice,
        getTaxationInfo: () => ({
          destinationStateId: null,
          assessedTaxRate: 0,
          collectionEfficiency: 0,
        }),
      };

      const allocations = computeLocalClearing(input, new Map(), marketPrice, quantityEpsilon, { value: 0 });
      expect(allocations).toHaveLength(1);
      const allocation = allocations[0]!;
      expect(allocation.quantity).toBeGreaterThan(0);
      expect(allocation.seller).toEqual({
        type: "PRODUCTION_UNIT",
        productionUnitId: counterparties.sellerUnitId,
      });
      expect(allocation.buyer).toEqual({ type: "COHORT", cohortId: counterparties.buyerCohortId });

      const context = { ...initializeTickContext(0, world.seed), phase: 8 };
      const settledWorld = executeAllocation(world, context, allocation);
      const sellerInventoryAfter =
        settledWorld.productionUnits.get(counterparties.sellerUnitId)!.outputInventory.get(counterparties.goodId) ?? 0;
      const buyerInventoryAfter =
        settledWorld.cohorts.get(counterparties.buyerCohortId)!.householdInventory.get(counterparties.goodId) ?? 0;

      assertMtfxI2GoodsTransfer(
        sellerInventoryBefore,
        buyerInventoryBefore,
        sellerInventoryAfter,
        buyerInventoryAfter,
        allocation.quantity,
      );

      // Sensitive negative controls: the proof must fail if either production mutation is
      // bypassed or reversed. These call the same assertion helper used for the real path,
      // so a future regression cannot keep MTFX-I2 green merely by preserving arithmetic
      // in a test-local fixture.
      expect(() =>
        assertMtfxI2GoodsTransfer(
          sellerInventoryBefore,
          buyerInventoryBefore,
          sellerInventoryBefore,
          buyerInventoryAfter,
          allocation.quantity,
        ),
      ).toThrow();
      expect(() =>
        assertMtfxI2GoodsTransfer(
          sellerInventoryBefore,
          buyerInventoryBefore,
          sellerInventoryAfter,
          buyerInventoryBefore - allocation.quantity,
          allocation.quantity,
        ),
      ).toThrow();

      const marketSaleTx = createMarketSaleTransaction(
        allocation,
        "tb:test-bundle-i2-0" as any,
        0,
        8,
        { value: 0 },
      );
      expect(marketSaleTx.goodId).toBe(counterparties.goodId);
      expect(marketSaleTx.quantity).toBe(allocation.quantity);
      expect(marketSaleTx.source?.type).toBe("PRODUCTION_UNIT");
      expect(marketSaleTx.destination?.type).toBe("COHORT");
    });
  });
