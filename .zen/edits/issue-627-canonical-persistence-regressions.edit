    const moneyEpsilon = base.world.simulationConfig.numeric.moneyEpsilon ?? 1e-9;
    const canonicalSupply = base.phase3Authority.laborSupplyPlans?.find(
      (plan) => plan.cohortId === base.laborAllocation.cohortId,
